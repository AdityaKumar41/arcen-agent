---
import { navGroups, normalizePath } from "../lib/navigation";
import Icon from "./Icon.astro";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const activePath = normalizePath(currentPath);
---

<aside class="docs-sidebar" aria-label="Documentation navigation">
  <div class="sidebar-scroll">
    <a href="/docs/reference/commands" class="sidebar-search">
      <span>Search documentation</span>
      <kbd>/</kbd>
    </a>

    {navGroups.map(group => (
      <section class="mb-7">
        <h2 class="mb-2 px-2 text-xs font-semibold text-zinc-500">{group.title}</h2>
        <nav class="space-y-1">
          {group.items.map(item => {
            const isActive = activePath === item.href;
            return (
              <a
                href={item.href}
                class:list={[
                  "group flex min-h-9 items-center gap-2 rounded-lg px-2.5 py-2 text-sm transition",
                  isActive
                    ? "bg-white/[0.08] font-semibold text-white"
                    : "text-zinc-400 hover:bg-white/[0.05] hover:text-white"
                ]}
              >
                <Icon name={item.icon} class="size-4 shrink-0" />
                <span>{item.title}</span>
              </a>
            );
          })}
        </nav>
      </section>
    ))}
  </div>
</aside>
