---
import { flatNavItems } from "../lib/navigation";
import Icon from "./Icon.astro";

interface Props {
  id?: string;
}

const { id = "docs-search" } = Astro.props;

const searchIndex = flatNavItems.map(item => ({
  title: item.title,
  href: item.href,
  description: item.description,
  group: item.href.includes("/reference/")
    ? "Reference"
    : item.href.includes("/developer-guide/")
      ? "Developer guide"
      : item.href.includes("/deployment/")
        ? "Operations"
        : item.href.includes("/features/")
          ? "Features"
          : item.href.includes("/user-guide/")
            ? "User guide"
            : "Start"
}));
---

<div
  class="relative min-w-0"
  data-search-root
  data-search-index={JSON.stringify(searchIndex)}
>
  <label class="sr-only" for={id}>Search documentation</label>
  <div class="flex h-9 min-w-0 items-center gap-2.5 rounded-none border border-white/10 bg-white/[0.025] px-3 text-sm text-zinc-400 shadow-sm transition focus-within:border-[#0029ff] focus-within:bg-white/[0.045] font-mono">
    <Icon name="search" class="size-4 shrink-0 text-zinc-500" />
    <input
      id={id}
      data-search-input
      type="search"
      autocomplete="off"
      placeholder="Search..."
      class="min-w-0 flex-1 bg-transparent text-sm text-white outline-none placeholder:text-zinc-500"
    />
    <kbd class="rounded-none border border-white/10 bg-white/[0.04] px-1.5 py-0.5 text-[10px] text-zinc-500 max-sm:hidden">⌘K</kbd>
  </div>

  <div
    class="absolute left-0 right-0 top-11 z-50 hidden overflow-hidden rounded-none border border-white/10 bg-[#0d0d0d] shadow-soft"
    data-search-panel
  >
    <div class="max-h-[430px] overflow-y-auto p-2" data-search-results></div>
  </div>
</div>

<script>
  interface SearchItem {
    title: string;
    href: string;
    description: string;
    group: string;
  }

  const searchRoots = document.querySelectorAll("[data-search-root]");

  for (const root of searchRoots) {
    const input = root.querySelector("[data-search-input]");
    const panel = root.querySelector("[data-search-panel]");
    const results = root.querySelector("[data-search-results]");
    const index = JSON.parse(root.getAttribute("data-search-index") || "[]") as SearchItem[];

    if (!(input instanceof HTMLInputElement) || !panel || !results) {
      continue;
    }

    const normalize = (value: string) => value.toLowerCase().trim();

    const render = (query: string) => {
      const q = normalize(query);
      const matches = q
        ? index
            .filter((item: SearchItem) =>
              normalize(`${item.title} ${item.description} ${item.group}`).includes(q)
            )
            .slice(0, 8)
        : index.slice(0, 8);

      results.innerHTML = matches.length
        ? matches
            .map(
              (item: SearchItem) => `
                <a href="${item.href}" class="block rounded-none px-4 py-3 transition hover:bg-white/[0.06] border-l-2 border-l-transparent hover:border-l-[#0029ff]" data-search-result>
                  <span class="block text-sm font-semibold text-white font-mono">${item.title}</span>
                  <span class="mt-1 block text-xs text-zinc-500 font-mono">${item.group}</span>
                  <span class="mt-1 block text-sm leading-6 text-zinc-400 font-mono">${item.description}</span>
                </a>
              `
            )
            .join("")
        : `<p class="px-4 py-5 text-sm text-zinc-500">No results found.</p>`;

      panel.classList.remove("hidden");
    };

    input.addEventListener("focus", () => render(input.value));
    input.addEventListener("click", () => render(input.value));
    input.addEventListener("input", () => render(input.value));
    input.addEventListener("keydown", event => {
      if (event.key === "Escape") {
        panel.classList.add("hidden");
        input.blur();
      }

      if (event.key === "Enter") {
        const first = results.querySelector("[data-search-result]");
        if (first instanceof HTMLAnchorElement) {
          window.location.href = first.href;
        }
      }
    });

    document.addEventListener("click", event => {
      if (event.target instanceof Node && !root.contains(event.target)) {
        panel.classList.add("hidden");
      }
    });
  }

  document.addEventListener("keydown", event => {
    const target = event.target;
    const isTyping =
      target instanceof HTMLInputElement ||
      target instanceof HTMLTextAreaElement ||
      target instanceof HTMLSelectElement ||
      target instanceof HTMLElement && target.isContentEditable;

    const shouldFocus =
      (event.key === "/" && !isTyping) ||
      ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k");

    if (shouldFocus) {
      event.preventDefault();
      const inputs = Array.from(document.querySelectorAll("[data-search-input]"));
      const input = inputs.find(candidate => candidate instanceof HTMLInputElement && candidate.offsetParent !== null);
      if (input instanceof HTMLInputElement) {
        input.focus();
      }
    }
  });
</script>
