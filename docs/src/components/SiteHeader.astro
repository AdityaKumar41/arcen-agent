---
import Icon from "./Icon.astro";
import SearchBox from "./SearchBox.astro";
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-arcen-950/90 backdrop-blur-xl">
  <div class="mx-auto grid h-20 max-w-[1720px] grid-cols-[minmax(220px,1fr)_minmax(280px,620px)_minmax(220px,1fr)] items-center gap-8 px-8 max-lg:grid-cols-[1fr_auto] max-md:h-16 max-md:px-4">
    <a href="/docs" class="text-4xl font-bold tracking-normal text-white max-md:text-2xl" aria-label="Arcen Agent documentation home">
      Arcen Agent
    </a>

    <div class="max-lg:hidden">
      <SearchBox id="docs-search-desktop" />
    </div>

    <div class="flex items-center justify-end gap-2">
      <a
        href="https://arcenpay.com"
        class="inline-flex h-11 items-center rounded-xl bg-white px-4 text-sm font-semibold text-arcen-950 transition hover:bg-zinc-200 max-sm:hidden"
      >
        ArcenPay
      </a>
      <a
        href="https://github.com/AdityaKumar41/arcen-agent"
        class="inline-flex h-11 items-center gap-2 rounded-xl border border-white/10 bg-white/[0.035] px-4 text-sm font-semibold text-zinc-200 transition hover:border-white/20 hover:bg-white/[0.06] hover:text-white max-sm:size-10 max-sm:justify-center max-sm:px-0"
        aria-label="GitHub repository"
      >
        <Icon name="github" class="size-5" />
        <span class="max-sm:hidden">GitHub</span>
      </a>
    </div>
  </div>

  <div class="border-t border-white/10 px-4 py-3 lg:hidden">
    <SearchBox id="docs-search-mobile" />
  </div>
</header>
