---
import Icon from "./Icon.astro";
import SearchBox from "./SearchBox.astro";
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-black/60 backdrop-blur-md">
  <div class="mx-auto grid h-20 max-w-[1720px] grid-cols-[minmax(220px,1fr)_minmax(280px,620px)_minmax(220px,1fr)] items-center gap-8 px-8 max-lg:grid-cols-[1fr_auto] max-md:h-16 max-md:px-4">
    <a href="/" class="flex items-center gap-2 group" aria-label="Arcen Agent documentation home">
      <span class="font-bold tracking-tight text-sm normal-case text-white">Arcen Agent</span>
      <span class="text-[9px] text-white/60 border border-white/20 px-1 py-0.5 rounded bg-white/10 font-mono">v1.0.0</span>
    </a>

    <div class="max-lg:hidden">
      <SearchBox id="docs-search-desktop" />
    </div>

    <div class="flex items-center justify-end gap-3">
      <a
        href="https://arcenpay.com"
        class="inline-flex h-9 items-center rounded-none bg-white px-4 text-[10px] font-bold uppercase tracking-wider text-[#0029ff] transition hover:bg-white/95 font-mono shadow-sm max-sm:hidden"
      >
        ArcenPay
      </a>
      <a
        href="https://github.com/AdityaKumar41/arcen-agent"
        class="inline-flex h-9 items-center gap-1.5 rounded-none border border-white/20 bg-transparent px-4 text-[10px] font-bold uppercase tracking-wider text-white transition hover:bg-white/10 max-sm:size-9 max-sm:justify-center max-sm:px-0 font-mono"
        aria-label="GitHub repository"
      >
        <Icon name="github" class="size-3.5 shrink-0" />
        <span class="max-sm:hidden">GitHub</span>
      </a>
    </div>
  </div>

  <div class="border-t border-white/10 px-4 py-3 lg:hidden">
    <SearchBox id="docs-search-mobile" />
  </div>
</header>
